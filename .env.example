# Copy to `.env` and fill in. Everything is optional except where noted:
# the pipeline degrades gracefully and records a per-task error instead of
# aborting when a credential is missing.

# ---------------------------------------------------------------------------
# Apify - follower counts and comments (public scraping, no social login/OAuth)
# Get a token at https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# OpenAI - Saudi-dialect sentiment analysis
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# gpt-4o-mini is the cost/quality default. Use gpt-4o for the hardest
# sarcasm cases.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Google Sheets mirror (optional - SQLite is always written)
# 1. Create a service account in Google Cloud and download its JSON key.
# 2. Share the target spreadsheet with the service account's email as Editor.
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Alternative to the file above: paste the whole JSON key on one line.
# Useful for CI secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Weekly email (SMTP). For Gmail use an App Password, not the account password.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=JSDO Social Reporting <no-reply@jsdo.gov.sa>
# Comma-separated. Overrides email.recipients in config/settings.yaml.
EMAIL_RECIPIENTS=

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Public URL included in the weekly email.
DASHBOARD_URL=http://localhost:8501

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Overrides storage.sqlite_path from settings.yaml.
SQLITE_PATH=
